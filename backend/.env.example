# ===== LandStack Backend Environment =====
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file or real credentials to Git.

# MongoDB connection string (REQUIRED). Use the `mongodb+srv://` Atlas URI
# for the development environment. Do not hardcode this anywhere else.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/landstack?retryWrites=true&w=majority

# MongoDB database name (optional, defaults to "landstack")
MONGODB_DB_NAME=landstack

# DNS servers applied to the Node process resolver (comma separated, optional).
# Some machines route DNS through a local stub (the poorly named 127.0.0.1) that
# refuses SRV records, so mongodb+srv:// fails with "querySrv ECONNREFUSED" even
# though the system DNS works. Set this to a reachable upstream resolver to fix it.
DNS_SERVERS=8.8.8.8

# Backend port
PORT=4000

# JSON Web Token secret for real-user authentication.
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Whitelisted origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Gemini AI (optional) — powers /api/ai/* with real LLM reasoning. When unset or
# unreachable the API falls back to labeled "demo reasoning", so the app still works.
# NEVER commit the real key. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model id; keep this current with the Google Gemini docs. Older models
# (e.g. gemini-2.0-flash) are retired and return 404 — update rather than pin a dead one.
GEMINI_MODEL=gemini-3.6-flash
# Optional request timeout for Gemini calls in milliseconds (default 15000).
GEMINI_TIMEOUT_MS=15000
