# ===== LandStack Backend Environment =====
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file or real credentials to Git.

# MongoDB connection string (REQUIRED). Use the `mongodb+srv://` Atlas URI
# for the development environment. Do not hardcode this anywhere else.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/landstack?retryWrites=true&w=majority

# MongoDB database name (optional, defaults to "landstack")
MONGODB_DB_NAME=landstack

# Backend port
PORT=4000

# JSON Web Token secret for real-user authentication.
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Whitelisted origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
